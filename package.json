{
  "name": "threadboard",
  "productName": "Weft",
  "version": "0.1.0",
  "description": "A board for your AI",
  "author": "Alex Miller <fotoflo@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aimhuge/weft.git"
  },
  "homepage": "https://github.com/aimhuge/weft#readme",
  "bugs": "https://github.com/aimhuge/weft/issues",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node electron/free-port.cjs 1000 .next && next dev -H 127.0.0.1 -p 1000",
    "desktop": "electron .",
    "build": "next build",
    "start": "electron .",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "prepare": "git config core.hooksPath .githooks || true",
    "app": "THREADBOARD_DIST=.next-app next build && THREADBOARD_DIST=.next-app THREADBOARD_PROD=1 electron .",
    "dist": "THREADBOARD_DIST=.next-dist THREADBOARD_STANDALONE=1 next build && node scripts/prepare-standalone.mjs .next-dist && electron-builder --mac --dir",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.293",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.7",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "app.weft.desktop",
    "productName": "Weft",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules${/*}"
    ],
    "asar": true,
    "npmRebuild": false,
    "extraResources": [
      {
        "from": ".next-dist/standalone",
        "to": "server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next-dist/standalone/node_modules",
        "to": "server/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "plugin",
        "to": "plugin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "protocols": [
      {
        "name": "Weft",
        "schemes": [
          "weft"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Weft opens Terminal to run a command-line tool's login when it needs a real terminal.",
        "NSMicrophoneUsageDescription": "Weft listens when you press the mic button, to type your prompt for you. The audio is transcribed on this Mac.",
        "LSUIElement": false
      }
    }
  }
}
